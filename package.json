{
  "name": "playwright_project_practice",
  "version": "1.0.0",
  "description": "Playwright BDD Automation Testing Framework using Cucumber and TypeScript",
  "main": "index.js",
  "scripts": {
    "test": "cucumber-js",
    "posttest": "tsx src/utilities/report.ts",
    "muhindhar": "cucumber-js --tags @Muhindhar --format progress --format json:reports/cucumber-report.json --format allure-cucumberjs/reporter",
    "rerun": "cucumber-js @rerun.txt --format json:reports/cucumber-report.json --format allure-cucumberjs/reporter",
    "report": "tsx src/utilities/report.ts",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@cucumber/cucumber": "^13.1.1",
    "@cucumber/html-formatter": "^24.0.0",
    "@faker-js/faker": "^10.5.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "allure-commandline": "^2.43.0",
    "allure-cucumberjs": "^3.10.2",
    "allure-js-commons": "^3.10.2",
    "allure-playwright": "^3.10.2",
    "cross-env": "^10.1.0",
    "csv-parse": "^7.0.1",
    "cucumber-html-reporter": "^7.2.0",
    "dotenv": "^17.4.2",
    "multiple-cucumber-html-reporter": "^3.10.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "winston": "^3.19.0",
    "xlsx": "^0.18.5"
  }
}
